# Dependências
/vendor/

# Ambiente
/.env

# Armazenamento gerado em runtime
/storage/pdfs/*
/storage/assinaturas/*
/storage/anexos/*
!/storage/pdfs/.gitkeep
!/storage/assinaturas/.gitkeep
!/storage/anexos/.gitkeep

# Credencial do Google Drive (segredo — nunca versionar)
/storage/credentials/*
!/storage/credentials/.gitkeep

# Projeto Android — artefatos de build e chave privada
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
# Chave privada do APK e senha de assinatura (segredos — nunca versionar)
/android/*.keystore
/android/keystore.properties
/android/app-release-*.apk
/android/app-release-*.aab
/android/*.idsig
# Casco do app empacotado no APK (gerado por android/tools/sync-web.sh)
/android/app/src/main/assets/site/

# APK publicado (artefato de build — gerado pelo projeto em /android)
/html/apk/*.apk

# Logs e temporários
*.log
.DS_Store
Thumbs.db
