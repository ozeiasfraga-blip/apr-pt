{
    "name": "aprpt/app",
    "description": "Sistema de APR/PT (Análise Preliminar de Risco e Permissão de Trabalho) integrado ao IXC Soft",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.0",
        "dompdf/dompdf": "^3.1",
        "google/apiclient": "^2.20"
    },
    "config": {
        "allow-plugins": {},
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "scripts": {
        "post-install-cmd": [
            "echo 'APR/PT instalado com sucesso!'"
        ]
    }
}
