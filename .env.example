# ── Aplicação ────────────────────────────────────────────────
APP_NAME="APR/PT"
APP_URL=http://localhost
APP_ENV=development

# ── Banco de dados próprio ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apr_pt
DB_USER=apr_pt
DB_PASS=apr_pt_change_me_2026

# ── Autenticação ─────────────────────────────────────────────
JWT_SECRET=troque_este_segredo_em_producao_2026
JWT_EXPIRY=43200

# ── Integração IXC Soft ──────────────────────────────────────
# URL base do webservice do provedor (cada provedor tem a sua)
IXC_BASE_URL=https://SEU_DOMINIO/webservice/v1
# Usuário/token gerados no cadastro do usuário da API no IXC
IXC_USER=
IXC_TOKEN=
# Verifica o certificado SSL do IXC (false para certificado auto-assinado)
IXC_VERIFY_SSL=false
# Quantidade de registros por página na sincronização
IXC_PAGE_SIZE=100

# ── Armazenamento ────────────────────────────────────────────
STORAGE_PATH=storage

# ── Nuvem via rclone (ex.: Google Drive) — segunda cópia do PDF
# Token gerado por `rclone authorize drive` no PC (uma única vez).
RCLONE_BIN=rclone
RCLONE_CONFIG=storage/credentials/rclone.conf
RCLONE_REMOTE=nwt
RCLONE_DIR=APR-PT
